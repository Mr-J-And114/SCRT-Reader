	"tasks": {
		"equipment_check": {
			"name": "设备状态检查",
			"description": "检查所有环境监测传感器的运行状态和供电情况",
			"command": "env check",
			"type": "inspection",
			"required": true,
			"order": 1,
			"time_estimate_min": 3,
			"sensors_to_check": ["air_temp", "humidity", "pressure", "wind_speed", "mag_field", "radiation"]
		},
		"weather_reading": {
			"name": "气象数据记录",
			"description": "记录主要气象参数：气温、湿度、气压、风速风向、云量",
			"command": "env read atmosphere",
			"type": "recording",
			"required": true,
			"order": 2,
			"time_estimate_min": 5,
			"sensors": ["air_temp", "humidity", "pressure", "wind_speed", "wind_dir", "cloud_cover", "visibility", "precipitation"]
		},
		"ocean_reading": {
			"name": "海洋数据记录",
			"description": "记录海水温度、潮位、浪高、盐度等海洋参数",
			"command": "env read ocean",
			"type": "recording",
			"required": false,
			"order": 3,
			"time_estimate_min": 5,
			"sensors": ["sea_temp", "tide_level", "wave_height", "salinity"]
		},
		"geophysics_reading": {
			"name": "地球物理数据记录",
			"description": "记录磁场、辐射、地震活动、地温等地球物理参数",
			"command": "env read geophysics",
			"type": "recording",
			"required": false,
			"order": 4,
			"time_estimate_min": 4,
			"sensors": ["mag_field", "mag_declination", "radiation", "seismic", "soil_temp"]
		},
		"composition_reading": {
			"name": "大气成分分析",
			"description": "读取大气成分分析仪数据，记录O2/CO2浓度",
			"command": "env read composition",
			"type": "recording",
			"required": false,
			"order": 5,
			"time_estimate_min": 3,
			"sensors": ["o2_concentration", "co2_concentration"]
		},
		"calibration": {
			"name": "仪器校准",
			"description": "对气压计和磁力计进行日常校准，检查偏移量",
			"command": "env calibrate",
			"type": "maintenance",
			"required": false,
			"order": 6,
			"time_estimate_min": 4,
			"sensors_to_calibrate": ["pressure", "mag_field"]
		},
		"anomaly_check": {
			"name": "异常检查",
			"description": "审查所有参数是否在正常范围内，标记异常值",
			"command": "env anomaly",
			"type": "analysis",
			"required": true,
			"order": 7,
			"time_estimate_min": 3
		},
		"daily_report": {
			"name": "日报提交",
			"description": "编译当日所有数据并提交日报给总部",
			"command": "env report",
			"type": "report",
			"required": true,
			"order": 8,
			"time_estimate_min": 3,
			"requires_tasks": ["weather_reading", "anomaly_check"]
		}
	},

	"anomaly_types": {
		"magnetic_spike": {
			"name": "磁场异常尖峰",
			"description": "磁场强度突然偏离正常值 ±500nT 以上",
			"severity": "warning",
			"sensor": "mag_field",
			"threshold_deviation": 500,
			"scp_related": true,
			"report_template": "检测到磁场异常波动。峰值偏差：{deviation}nT。持续时间：{duration}。建议启动 Epsilon 协议。"
		},
		"radiation_elevation": {
			"name": "辐射水平升高",
			"description": "背景辐射超过 0.3 μSv/h",
			"severity": "caution",
			"sensor": "radiation",
			"threshold_absolute": 0.3,
			"scp_related": false,
			"report_template": "背景辐射读数异常：{value} μSv/h（基线 {baseline} μSv/h）。已记录。"
		},
		"pressure_drop": {
			"name": "气压骤降",
			"description": "气压在 3 小时内下降超过 10 hPa",
			"severity": "warning",
			"sensor": "pressure",
			"threshold_rate": -3.33,
			"scp_related": false,
			"report_template": "气压快速下降中：当前 {value} hPa，3h变化 {delta} hPa。可能有强风暴接近。"
		},
		"temperature_inversion": {
			"name": "温度逆转",
			"description": "气温在短时间内出现 10°C 以上异常波动",
			"severity": "anomalous",
			"sensor": "air_temp",
			"threshold_deviation": 10.0,
			"scp_related": true,
			"report_template": "[异常] 气温读数出现无法解释的变化：{value}°C（预期 {expected}°C）。偏差：{deviation}°C。"
		},
		"composition_shift": {
			"name": "大气成分异常",
			"description": "O2 浓度偏离正常值 0.5% 以上或出现未知气体",
			"severity": "anomalous",
			"sensor": "o2_concentration",
			"threshold_deviation": 0.5,
			"scp_related": true,
			"report_template": "[异常] 大气成分分析显示异常：O2={o2}%，CO2={co2}ppm。检测到未编目气体成分。"
		},
		"seismic_event": {
			"name": "地震活动",
			"description": "地震传感器记录到超过 10mg 的震动",
			"severity": "caution",
