{
	"_comment": "主线剧情清单 —— 定义每日对话、角色、事件触发等。可由 .scp 故事包覆盖或扩展。",
	"story": {
		"id": "main_storyline",
		"title": "OB-7K 观测站",
		"description": "萨哈林岛 Site-██ 环境监测前哨站日常运营主线剧情",
		"version": "0.2.0"
	},
	"daily_dialogues": {
		"_comment": "每日对话触发配置。day 编号对应 env_monitor.current_day。",
		"1": {
			"on_start": ["day1_briefing"],
			"on_scan_complete": ["day1_scan_done"],
			"on_anomaly": [],
			"mail_deliveries": [
				{
					"id": "welcome_mail",
					"title": "欢迎抵达 OB-7K",
					"from": "AVA <ava@site-ob7k.scp>",
					"persistent": true,
					"body": "From: AVA <ava@site-ob7k.scp>\nTo: {username}@site-ob7k.scp\nSubject: 欢迎抵达 OB-7K\n---\n操作员，\n\n欢迎来到 OB-7K 观测站。作为新到任的环境监测操作员，以下是你的日常工作流程：\n\n1. 每天登录后执行 env scan 完成自动检测\n2. 查看 env view 仪表盘确认数据\n3. 完成所有任务后关闭终端，系统将自动推进至下一天\n\n如需帮助，输入 help 查看可用命令。\n\n祝工作顺利。\n\n—— AVA, 联络 AI"
				}
			]
		},
		"2": {
			"on_start": ["day2_morning"],
			"on_scan_complete": [],
			"on_anomaly": ["day2_anomaly_reaction"],
			"mail_deliveries": [
				{
					"id": "day2_report",
					"title": "昨日数据汇总",
					"from": "HQ-CONTROL <hq@foundation.scp>",
					"persistent": true,
					"body": "From: HQ-CONTROL <hq@foundation.scp>\nTo: OB-7K Operator\nSubject: 昨日数据汇总\n---\n操作员，\n\n总部已收到你第一天的环境监测报告。数据质量合格。\n\n请注意：昨晚自动气象站记录到微弱信号波动。\n可能是风暴前兆，也可能是其他因素。\n\n请保持警惕，继续执行日常监测。\n\n—— 总部管控中心"
				}
			]
		},
		"3": {
			"on_start": ["day3_morning"],
			"on_scan_complete": [],
			"on_anomaly": [],
			"mail_deliveries": [
				{
					"id": "day3_notice",
					"title": "[机密] 异常评估报告",
					"from": "Site Director <director@site-██.scp>",
					"persistent": true,
					"body": "From: Site Director\nTo: OB-7K Operator\nSubject: [机密] 异常评估报告\nPriority: HIGH\n---\n操作员，\n\n经过 48 小时的数据分析，总部对你提交的异常报告做出了初步评估：\n\n  分类：待定（暂标为 Euclid 级）\n  风险等级：中\n  建议措施：持续监测，保持每日报告\n\n此信息为 Level-2 机密。请勿在非加密信道讨论。\n\n—— Site Director"
				}
			]
		},
		"default": {
			"_comment": "没有特定定义的天数使用此默认配置",
			"on_start": ["daily_routine_greeting"],
			"on_scan_complete": [],
			"on_anomaly": []
		}
	},
	"comm_characters": {
		"hq_control": {
			"id": "hq_control",
			"name": "总部管控",
			"title": "HQ-CONTROL",
			"voice": {
				"tone": "square",
				"base_pitch": 0.7,
				"pitch_variance": 0.05,
				"speed": "normal"
			}
		}
	},
	"comm_dialogues": {
		"day1_briefing": {
			"title": "第一天 — 到岗报告",
			"callable": false,
			"repeatable": false,
			"lines": [
				{
					"character": "ava",
					"text": "操作员，欢迎抵达 OB-7K 观测站。我是你的联络 AI，代号 AVA。",
					"speed": 30.0
				},
				{
					"character": "ava",
					"text": "从今天起，你将负责这座前哨站的日常环境监测工作。",
					"speed": 30.0
				},
				{
					"character": "ava",
					"text": "流程很简单：输入 [color=#ffaa00]env scan[/color] 执行自动检测。也可以用 [color=#ffaa00]mail[/color] 查看邮件。",
					"speed": 28.0
				},
				{
					"character": "ava",
					"text": "完成工作后关闭终端，下次启动将自动进入新的一天。祝工作顺利。",
					"speed": 30.0
				}
			]
		},
		"day1_scan_done": {
			"title": "第一天 — 扫描完成",
			"callable": false,
			"repeatable": false,
			"lines": [
				{
					"character": "ava",
					"text": "第一次自动扫描已完成。数据已上传至总部。",
					"speed": 30.0
				},
				{
					"character": "ava",
					"text": "你可以用 [color=#ffaa00]save[/color] 手动保存进度。关闭终端后再次启动将进入下一天。",
					"speed": 28.0
				}
			]
		},
		"day2_morning": {
			"title": "第二天 — 晨间通讯",
			"callable": false,
			"repeatable": false,
			"lines": [
				{
					"character": "ava",
					"text": "早安，操作员。新的一天开始了。你应该收到了总部的邮件。",
					"speed": 30.0
				},
				{
					"character": "ava",
					"text": "昨晚自动气象站记录到一些微弱的信号波动。请执行 [color=#ffaa00]env scan[/color] 确认状态。",
					"speed": 28.0
				}
			]
		},
		"day2_anomaly_reaction": {
			"title": "第二天 — 异常反应",
			"callable": false,
			"repeatable": false,
			"lines": [
				{
					"character": "ava",
					"text": "注意——扫描结果中检测到异常数据。我已经标记并上报总部。",
					"speed": 28.0,
					"action": "glitch"
				},
				{
					"character": "ava",
					"text": "请保持关注。如果情况恶化，总部会发送进一步指令。",
					"speed": 30.0
				}
			]
		},
		"day3_morning": {
			"title": "第三天 — 例行通讯",
			"callable": false,
			"repeatable": false,
			"lines": [
				{
					"character": "ava",
					"text": "第三天。查看你的邮件——Site Director 发来了一份机密评估报告。",
					"speed": 28.0
				},
				{
					"character": "ava",
					"text": "总部对之前的异常做出了初步分类。请继续日常检测。",
					"speed": 30.0
				}
			]
		},
		"daily_routine_greeting": {
			"title": "日常晨间通讯",
			"callable": false,
			"repeatable": true,
			"lines": [
				{
					"character": "ava",
					"text": "新的一天，操作员。系统状态正常。请执行日常检测。",
					"speed": 30.0
				}
			]
		}
	},
	"camera_system": {
