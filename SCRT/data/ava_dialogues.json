			"repeatable": false,
			"lines": [
				{
					"character": "researcher",
					"text": "这里是 Dr. Zhang。操作员，收到了吗？",
					"speed": 25
				},
				{
					"character": "researcher",
					"text": "你刚才接听了一次「可接听模式」的来电。在这种模式下，铃声响起后你可以选择：\n  [color=#ffaa00]comm answer[/color]  —— 接听\n  [color=#ffaa00]comm reject[/color]  —— 拒绝",
					"speed": 18
				},
				{
					"character": "researcher",
					"text": "如果超时未响应，来电会自动挂断。拒绝来电可能影响后续剧情——具体取决于故事作者的设定。",
					"speed": 20
				},
				{
					"character": "researcher",
					"text": "好了，测试通讯结束。Zhang 断开。",
					"speed": 28
				}
			]
		}
	}
}
