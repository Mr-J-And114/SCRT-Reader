					"speed": 22
				}
			]
		},

		"answerable_call_demo": {
			"title": "可接听来电演示",
			"description": "可接听来电模式演示（玩家可选择接听或拒绝）",
			"trigger": "incoming_call",
			"call_mode": "answerable",
			"reject_consequence": "",
