                {
                    "character": "ava",
                    "text": "输入 [color=#ffaa00]help[/color] 获取命令列表。所有操作都在安全监控之下。",
                    "speed": 30
                }
            ]
        },
        "ava_chat_a3": {
            "title": "AVA - 闲聊回应",
            "callable": false,
            "repeatable": true,
            "lines": [
