        "ava_chat": {
            "title": "AVA - 闲聊",
            "description": "与联络员AVA进行简短交流",
            "callable": true,
            "repeatable": true,
            "lines": [
                {
                    "character": "ava",
                    "text": "有什么需要我协助的吗，特工？\n\n[color=#888888]1. 你是谁？[/color]\n[color=#888888]2. 这个系统是什么？[/color]\n[color=#888888]3. 没事，只是随便聊聊。[/color]",
                    "speed": 0,
                    "wait_for": "choice:ava_chat_q1"
                }
            ]
        },
        "ava_chat_a1": {
            "title": "AVA - 自我介绍",
            "callable": false,
            "repeatable": true,
            "lines": [
                {
                    "character": "ava",
                    "text": "我是 AVA —— 自适应虚拟助理。",
                    "speed": 35
                },
                {
                    "character": "ava",
                    "text": "我的职责是协助特工执行任务、管理通讯频道，以及提供系统操作指引。",
                    "speed": 30
                },
                {
                    "character": "ava",
                    "text": "虽然我是AI系统，但我会尽力提供有用的支持。",
                    "speed": 30
                }
            ]
        },
        "ava_chat_a2": {
            "title": "AVA - 系统介绍",
            "callable": false,
            "repeatable": true,
            "lines": [
                {
                    "character": "ava",
                    "text": "这是SCP基金会的安全终端系统。",
                    "speed": 35
