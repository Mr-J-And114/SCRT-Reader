                {
                    "character": "ava",
                    "text": "我已向总部发送紧急标记的报告。建议你查看邮件等待进一步指令。",
                    "speed": 28
                },
                {
                    "character": "ava",
                    "text": "操作员……注意安全。",
                    "speed": 30
                }
            ]
        },
        "day7_calm": {
            "title": "第七天 — 一周回顾",
            "callable": false,
            "repeatable": false,
            "lines": [
                {
                    "character": "ava",
                    "text": "恭喜你完成了第一周的值守工作，操作员。",
                    "speed": 30
                },
                {
                    "character": "ava",
                    "text": "虽然出现了一些意料之外的状况，但你的工作表现令人满意。总部已确认收到所有报告。",
                    "speed": 28
